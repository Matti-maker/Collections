public class MyLinkedList<E>
{
   
    private Node head;
   
    private Node tail;
  
    private int count;
 
    public MyLinkedList()
    {
        head = null;
        tail = null;
        count = 0;
    }
 
    public void add(E element)
    {
        Node newNode = new Node(element);
        if (isEmpty())
        {
            head = newNode;
        }
        else
        {
            tail.nextNode = newNode;
        }
        tail = newNode;
        count++;
    }
 
    public E getHead()
    {
        E first = null;
        if (isEmpty() == false)
        {
            first = head.getElement();
        }
        return first;
    }
 
    public boolean isEmpty()
    {
        return count == 0;
    }
 
    public int size()
    {
        return count;
    }
 
    public String toString()
    {
        String result = "";
        Node current = head;
        while (current != null)
        {
            result += current.getElement() + " ";
            current = current.getNextNode();
        }
        return result;
    }
 
    private class Node
    {
        private E element;
        private Node nextNode;
 
        private Node(E element)
        {
            this.element = element;
            nextNode = null;
        }
 
        public E getElement()
        {
            return element;
        }
 
        public Node getNextNode()
        {
            return nextNode;
        }
    }
}
